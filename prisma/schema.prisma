/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario_rol {
  id          String    @id @db.Char(26)
  empresa_id  String    @db.Char(26)
  usuario_id  String    @db.Char(26)
  rol_id      String    @db.Char(26)
  proyecto_id String?   @db.Char(26)
  activo      Boolean   @default(true)
  proyecto    proyecto? @relation(fields: [proyecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol_proyecto_id")
  empresa     empresa   @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol         rol       @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario     usuario   @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([empresa_id, usuario_id, rol_id, proyecto_id], map: "uq_usuario_rol")
}

