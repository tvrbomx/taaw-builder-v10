# Copiar a .env y llenar con valores reales. Nunca versionar .env.

# Cadena de conexión a PostgreSQL 16+. En producción, la del mini PC vía Dokploy.
DATABASE_URL="postgresql://usuario:password@host:5432/taaw_builder?schema=public"

# Firma de sesión de Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=""
